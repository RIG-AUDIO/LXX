# Normalise every text file to LF on commit and in the working tree.
* text=auto eol=lf

*.c      text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.hpp    text eol=lf
*.py     text eol=lf
*.cmake  text eol=lf
*.sh     text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.glsl   text eol=lf

CMakeLists.txt text eol=lf
LICENSE        text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Binary assets
*.ttf    binary
*.otf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.wav    binary
*.flac   binary
*.pdf    binary
*.zip    binary
